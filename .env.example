# Kết nối tới PostgreSQL chạy bằng docker-compose.yml
DATABASE_URL="postgresql://miu:miu@localhost:5432/miu"

# Khóa để ký cổng phụ huynh. Đổi thành chuỗi ngẫu nhiên dài khi triển khai thật.
SESSION_SECRET="doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai"

# Múi giờ dùng để tính "ngày học" cho báo cáo và giới hạn thời gian.
APP_TIMEZONE="Asia/Ho_Chi_Minh"

# Thư mục lưu hình, tiếng và gói bài khi chưa dùng Cloudflare R2.
STORAGE_DIR="./storage"

# Email của tài khoản phụ huynh tạo sẵn (seed).
SEED_PARENT_EMAIL="phuhuynh@miu.local"

# Email của người soạn nội dung tạo sẵn (seed), đăng nhập riêng ở /admin/login.
# Bỏ trống thì dùng chung email phụ huynh ở trên.
# SEED_STAFF_EMAIL="soanbai@miu.local"

# Chỉ để phát triển: cho phép xuất bản bài khi còn câu chưa có tệp tiếng.
# Bỏ dòng này (hoặc đặt 0) để bật quy tắc chặn xuất bản.
MIU_ALLOW_MISSING_AUDIO="1"

# Chỉ để phát triển: mã đăng nhập cố định. Không bao giờ dùng khi chạy thật.
# MIU_DEV_FIXED_CODE="246810"
